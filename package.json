    "@types/react-dom": "^19.2.4",
    "env-cmd": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.26",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "ultracite": "7.10.6"
  },
  "packageManager": "bun@1.3.9"
